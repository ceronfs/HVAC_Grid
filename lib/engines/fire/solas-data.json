 "notes": {
  "N_9192": {
   "a": "인접 구역이 같은 번호 범주이고 위첨자 a가 붙으면, 주관청이 불필요하다고 인정할 경우 그 사이 격벽·갑판을 설치하지 않아도 된다. 예: 조리실 ↔ 부속 팬트리. 다만 조리실 ↔ 기관구역은 둘 다 (12)여도 격벽이 필요하다.",
   "b": "경하흘수선까지의 선측, 그리고 구명뗏목·활강대 아래·인접한 상부구조·갑판실 측면은 A-30으로 완화할 수 있다.",
   "c": "공용화장실이 계단격실 내부에 완전히 들어가 있으면 그 화장실 격벽은 B급 완전성으로 가능하다.",
   "d": "범주 (6)(7)(8)(9) 구역이 집합장소 외곽 둘레 내부에 완전히 위치하면 그 격벽은 B-0급으로 가능하다. 음향·영상·조명 제어위치는 집합장소의 일부로 볼 수 있다."
  },
  "N_9394": {
   "a": "어느 쪽이 적용되는지는 II-2/9.2.2.2 및 9.2.2.5 참조 (격벽이 갑판까지 연장되는지 여부).",
   "b": "인접 구역이 같은 번호 범주이고 위첨자 b가 붙으면, 표의 등급은 인접 구역의 용도가 서로 다를 때에만 요구된다. 조리실↔조리실은 불요, 조리실↔페인트실은 A-0 필요.",
   "c": "조타실 ↔ 해도실 격벽은 B-0 가능. 안전센터가 선교 내부에 있으면 선교와 안전센터를 나누는 칸막이에는 내화등급이 요구되지 않는다.",
   "d": "II-2/9.2.2.4.2.3 및 .4 참조 — 양쪽 모두 스프링클러 미설치면 큰 값, 양쪽 모두 설치면 작은 값, 한쪽만 설치면 큰 값.",
   "e": "II-2/9.2.1.1.2 적용 시 Table 9.3의 B-0 및 C는 A-0으로 읽는다.",
   "f": "범주 (7) 기관구역이 주관청 판단상 화재위험이 거의 없으면 내화 단열은 불요."
  },
  "N_9596": {
   "a": "방식 IIC 및 IIIC 방화에서는 격벽에 특별한 요건이 부과되지 않는다.",
   "b": "방식 IIIC에서는 50㎡ 이상의 구역 또는 구역군 사이에 B-0급 B급 격벽을 설치한다.",
   "c": "어느 쪽이 적용되는지는 II-2/9.2.3.2 및 9.2.3.4 참조 (격벽이 갑판까지 연장되는지 여부).",
   "d": "인접 구역이 같은 번호 범주이고 위첨자 d가 붙으면, 표의 등급은 인접 구역의 용도가 서로 다를 때에만 요구된다. 조리실↔조리실은 불요, 조리실↔페인트실은 A-0 필요.",
   "e": "조타실 · 해도실 · 무선실 상호간 격벽은 B-0 가능.",
   "f": "위험물을 운송하지 않거나, 위험물이 그 격벽으로부터 수평 3m 이상 이격되어 적재되면 A-0 사용 가능.",
   "g": "위험물 운송 예정 화물구역은 II-2/19.3.8 적용.",
   "h": "Ro-ro 구역을 분리하는 격벽·갑판은 합리적으로 가스밀 폐쇄가 가능해야 하며, 주관청이 화재위험이 거의 없다고 판단하는 경우 실행 가능한 범위에서 A급 완전성을 가질 것.",
   "i": "범주 (7) 기관구역이 주관청 판단상 화재위험이 거의 없으면 내화 단열은 불요."
  },
  "N_9798": {
   "a": "어느 쪽이 적용되는지는 II-2/9.2.3.2 및 9.2.3.4 참조 (격벽이 갑판까지 연장되는지 여부).",
   "b": "인접 구역이 같은 번호 범주이고 위첨자 b가 붙으면, 표의 등급은 인접 구역의 용도가 서로 다를 때에만 요구된다. 조리실↔조리실은 불요, 조리실↔페인트실은 A-0 필요.",
   "c": "조타실 · 해도실 · 무선실 상호간 격벽은 B-0 가능.",
   "d": "화물펌프실 ↔ A류 기관구역 사이의 격벽·갑판은 화물펌프 축봉 등 글랜드 관통이 허용된다 — 효율적 윤활을 갖춘 가스타이트 실 또는 가스 실의 영속성을 보장하는 다른 수단을 설치할 것.",
   "e": "범주 (7) 기관구역이 주관청 판단상 화재위험이 거의 없으면 내화 단열은 불요."
  }
 },
 "star": "강 또는 동등재이되 A급은 불요. 다만 갑판이 전선·배관·환기덕트 관통을 위해 뚫리면 화염·연기 통과를 막도록 밀폐할 것. 비상발전기실↔개방갑판 구획은 고정식 가스소화 미설치 시 폐쇄수단 없는 공기흡입구가 허용된다.",
